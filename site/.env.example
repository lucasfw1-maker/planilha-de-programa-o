# Configure estas variáveis PRIVADAS no projeto Vercel do site (Root Directory: site).
# Copie o servidor SMTP indicado pela Locaweb para sua conta, sem https://.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=comercial@concretlog.com.br
CONTACT_SMTP_PASSWORD=
# Opcional; já usa https://concretlog.com.br por padrão.
CONTACT_SITE_ORIGIN=https://concretlog.com.br
