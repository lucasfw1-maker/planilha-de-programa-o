# Development uses a local SQLite file if no remote URL is set.
# Do not commit a populated .env file or any credentials.
# The app does not load .env automatically; use your host settings or node --env-file.

# Vercel requires a SEPARATE persistent database for this project.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required only while registering the first Programador in production.
# Choose a unique random code with at least 32 characters in secure host settings.
ADMIN_SETUP_TOKEN=

# Optional: exact HTTPS origin for the published application.
# On Vercel the default is the request hostname over HTTPS.
APP_ORIGIN=

# Local development only. Never used as fallback on Vercel.
# DB_PATH=.data/cascavel.sqlite
# PORT=3000
# HOST=127.0.0.1
